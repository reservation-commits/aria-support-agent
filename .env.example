# --- Server ---
PORT=3000
WEBHOOK_PATH=/webhook/whatsapp
# URL pública DESTE servidor (Easypanel), sem barra no fim. Usada para os ícones
# do rodapé dos emails. Ex.: https://theworldkeys-aria-whatsapp-agent.xis4ee.easypanel.host
# Se vazio, o rodapé do email usa ícones-emoji com rótulo (não bloqueáveis).
PUBLIC_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo mais capaz (padrão). Para respostas mais rápidas/baratas, use claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-opus-4-8

# --- WhatsApp Cloud API (Meta) ---
# Phone Number ID — encontre em business.facebook.com → WhatsApp Manager → seu número
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User Access Token (escopos: whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# Verify token: você inventa essa string. Cole a MESMA no campo "Token de Verificação"
# ao configurar o webhook no developers.facebook.com → seu app → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=trocar-por-string-aleatoria-longa
# App Secret — em developers.facebook.com → seu app → Settings → Basic → App Secret
# (opcional mas RECOMENDADO em produção — sem ele, qualquer um pode chamar o webhook)
WHATSAPP_APP_SECRET=
# Versão da Graph API (opcional)
WHATSAPP_GRAPH_VERSION=v21.0

# --- PostgreSQL (Google Cloud) ---
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSL=true
# Validar a cadeia de certificados SSL do banco (endurece contra MITM).
# Mantenha false para Cloud SQL com cert próprio; true se você tem CA confiável.
PGSSL_REJECT_UNAUTHORIZED=false

# --- Optional: OpenAI Whisper for audio transcription ---
# Se vazio, áudios recebem fallback educado pedindo reenvio em texto.
OPENAI_API_KEY=

# --- Google Maps Platform (Geocoding + Distance Matrix) ---
# Habilita endereço com link + cálculo de distância/tempo até o restaurante.
# Sem essa key, get_restaurant_location ainda funciona (gera link só com nome),
# mas geocoding e compute_route_to_restaurant ficam desativados.
GOOGLE_MAPS_API_KEY=

# Fuso para calcular "aberto agora" nas buscas por proximidade (mercado primário).
TWK_LOCAL_TZ=America/Sao_Paulo

# --- Session ---
SESSION_TTL_MINUTES=60
MAX_HISTORY_TURNS=20

# --- Reply pacing ---
# Tempo mínimo (em segundos) entre receber a mensagem e enviar a resposta.
# A Aria mostra "digitando..." durante esse intervalo. Padrão: 3s.
RESPONSE_MIN_DELAY_SECONDS=3
# Janela de coalescência (ms): mensagens em rajada do mesmo número são agrupadas
# num único turno do agente. Evita race condition e respostas desencontradas.
REPLY_DEBOUNCE_MS=2500

# --- Dashboard admin ---
# Defina os dois para habilitar o painel em /dashboard. Sem isso, fica desativado.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Outbound proativo: lembrete da reserva (2h antes) ---
# DESLIGADO por padrão. Para ligar: REMINDERS_ENABLED=true E um template aprovado
# no WhatsApp Manager (mesmo nome, com as traduções pt_BR / en / es / fr).
# O idioma é escolhido automaticamente pelo código do país do telefone do cliente.
# Corpo do template, nesta ordem: {{1}} primeiro nome · {{2}} restaurante · {{3}} horário
# Só envia para reservas com booking_status = REMINDERS_STATUS (padrão: accept).
REMINDERS_ENABLED=false
REMINDERS_TEMPLATE=
# Idioma padrão e idiomas REALMENTE aprovados no template (separados por vírgula).
# Comece com o que existe (pt_BR) e amplie conforme aprovar as traduções:
#   REMINDERS_LOCALES=pt_BR,en,es,fr
REMINDERS_DEFAULT_LOCALE=pt_BR
REMINDERS_LOCALES=pt_BR
REMINDERS_HOURS_BEFORE=2
REMINDERS_STATUS=accept
REMINDERS_SWEEP_MINUTES=20

# --- Canal de EMAIL (Gmail API) ---
# DESLIGADO por padrão. A Aria atende a caixa (ex: support@theworldkeys.com)
# com o MESMO motor do WhatsApp: mesmos fluxos, tools de banco e precisão.
# Passo a passo das credenciais no README (seção "Canal de email").
EMAIL_ENABLED=false
EMAIL_ADDRESS=support@theworldkeys.com
# Caixas ADICIONAIS vigiadas via n8n (separadas por vírgula). Ex.: a caixa que
# envia as notificações de reserva e recebe as respostas dos restaurantes.
# Cada caixa extra precisa de um Gmail Trigger próprio no n8n apontando para o
# MESMO POST /webhook/email (inclua "mailbox" no corpo do HTTP Request) e de um
# ramo Switch no fluxo de envio (a resposta sai SEMPRE pela caixa que recebeu).
EMAIL_EXTRA_ADDRESSES=reservation@theworldkeys.com
EMAIL_FROM_NAME=Aria · The World Keys
# OAuth do Google Cloud (mesmo projeto do Maps serve): crie um OAuth Client ID
# tipo "Desktop app", habilite a Gmail API e gere um refresh token com escopo
# https://www.googleapis.com/auth/gmail.modify autorizado PELA PRÓPRIA CAIXA.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# — OU MODO N8N (recomendado se o n8n já está conectado à caixa): dispensa as
# credenciais acima. Entrada: fluxo Gmail Trigger → HTTP Request para
# https://SEU-DOMINIO/webhook/email (header x-aria-secret). Saída: webhook do
# n8n abaixo → nó Gmail (Reply). Receita completa no README.
N8N_EMAIL_SEND_WEBHOOK=
EMAIL_WEBHOOK_SECRET=
# Varredura da caixa (segundos) e idade máxima dos emails processados (dias —
# protege contra responder um backlog antigo de não-lidos ao ligar o canal).
EMAIL_POLL_SECONDS=60
EMAIL_MAX_AGE_DAYS=2

# --- Watchdog de reservas pendentes (escalação interna, SEM mensagem ao cliente) ---
# Reservas paradas em aprovação há PENDING_WATCH_HOURS+ geram uma escalação
# automática PENDENTE_12H no painel (uma vez por reserva). Ligue depois de
# confirmar qual booking_status representa "aguardando aprovação" no banco.
PENDING_WATCH_ENABLED=false
PENDING_WATCH_HOURS=12
PENDING_WATCH_STATUS=pending

# --- Pós-experiência: convite de avaliação (6h depois da reserva) ---
# DESLIGADO por padrão. Template aprovado (mesmo nome, traduções pt_BR/en/es/fr),
# corpo com placeholders: {{1}} primeiro nome · {{2}} restaurante.
# Ao responder, a Aria conduz a coleta (notas + tags + sugestão) e salva no banco.
REVIEW_ENABLED=false
REVIEW_TEMPLATE=
REVIEW_HOURS_AFTER=6
REVIEW_STATUS=accept

# --- Bloqueio de escopo (só clientes e estabelecimentos sobre a plataforma) ---
# A Aria IGNORA em silêncio newsletters, marketing/propaganda e relatórios
# automáticos de serviços contratados — e registra tudo no painel (aba "Fora de
# escopo") para você pegar eventual falso positivo. LIGADO por padrão.
# Camada 1 (custo zero): remetentes de ferramentas de email em massa + rodapé de
# descadastro. Camada 2: um classificador barato (SCOPE_MODEL) tria só a PRIMEIRA
# mensagem de cada contato novo e falha em ABERTO (na dúvida, atende).
SCOPE_FILTER_ENABLED=true
SCOPE_MODEL=claude-haiku-4-5-20251001

# --- Plataforma TWK ---
# Base URL da plataforma. Sem barra no fim. Usada para o link de login no fallback.
# O link da página de cada restaurante vem da coluna url_page_twk do banco.
TWK_PLATFORM_URL=https://theworldkeys.com

# ─────────────────────────────────────────────────────────────────────────────
# NOVOS RECURSOS (upgrade)
# ─────────────────────────────────────────────────────────────────────────────

# --- Produção fail-closed ---
# Com NODE_ENV=production o boot EXIGE: WHATSAPP_APP_SECRET (HMAC do webhook)
# e SSL do Postgres verificado. Cloud SQL com certificado próprio: reconheça
# explicitamente com PGSSL_ALLOW_UNVERIFIED=true (ou use PGSSL_REJECT_UNAUTHORIZED=true).
# NODE_ENV=production
# PGSSL_ALLOW_UNVERIFIED=true

# --- Teto diário de custo ---
# Tokens (input+output do modelo principal, dia UTC). 0 = sem teto. Ao atingir,
# a Aria degrada para o modelo de fallback até a virada do dia (nunca para de
# atender) e alerta no painel.
COST_DAILY_TOKEN_BUDGET=0
COST_FALLBACK_MODEL=claude-haiku-4-5-20251001

# --- Descoberta semântica + memória de longo prazo (embeddings) ---
# Requer OPENAI_API_KEY. Descoberta por "vibe" com busca vetorial híbrida
# (fundida com o full-text) e memória semântica: resumos de conversas antigas
# recuperados por relevância no início de cada nova conversa. Sem pgvector.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Briefing de véspera (concierge proativo) ---
# Template ~24h antes da reserva: {{1}} primeiro nome · {{2}} restaurante ·
# {{3}} data (DD/MM) · {{4}} horário (HH:MM). O cliente responde e a Aria
# orienta rota, dress code e observações dentro da janela de 24h.
BRIEFING_ENABLED=false
BRIEFING_TEMPLATE=
BRIEFING_HOURS_BEFORE=24

# --- Alertas por email para a equipe ---
# Escalação URGENTE, health check reprovado, teto de custo e testes falhando
# saem do navegador: email para a equipe via canal de email já configurado.
ALERTS_ENABLED=false
ALERT_EMAIL_TO=
ALERT_MIN_INTERVAL_MIN=30

# --- Painel multiusuário (auditoria por operador + RBAC) ---
# DASHBOARD_USER/PASSWORD continuam valendo (conta admin). Contas adicionais:
# DASHBOARD_USERS=ana:senha1,bruno:senha2 · admins extras: DASHBOARD_ADMINS=ana
DASHBOARD_USERS=
DASHBOARD_ADMINS=

# --- Pool do Postgres ---
# Conexões simultâneas do pool (conversas paralelas + serviços de fundo).
PGPOOL_MAX=10

# --- Bloco Campanha do painel (rastreamento de cliques via n8n) ---
# API REST do n8n, somente leitura das execucoes do workflow de clique (/go).
# Sem estas duas, o bloco mostra envios e ativacoes, mas avisa que cliques
# nao estao configurados.
N8N_API_URL=https://theworldkeys-n8n.xis4ee.easypanel.host
N8N_API_KEY=
# Workflow do rastreador de cliques (padrao ja aponta para o existente).
N8N_CLICK_WORKFLOW_ID=HoFjhfqzPmCAkrnZ
